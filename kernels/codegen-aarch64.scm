(define-library (ccweave kernel codegen-aarch64)
  (import (scheme base) (ccweave glue))
  (export kernel-info kernel-capabilities kernel-apply)
  (begin
    (define (kernel-info) '((name . codegen-aarch64) (version . "0.0.0") (description . "Selects machine instructions for AArch64 targets.")))
    (define (kernel-capabilities) '(codegen.aarch64))
    (define (kernel-apply capability ir options)
      (unless (eq? capability 'codegen.aarch64) (error "codegen-aarch64: unsupported capability" capability))
      (unless (list? options) (error "codegen-aarch64: options must be an alist" options))
      ir)))
