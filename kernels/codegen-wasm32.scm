;;; kernels/codegen-wasm32.scm
;;; CCWeave Kernel: WebAssembly (wasm32) instruction selection.

(define-library (ccweave kernel codegen-wasm32)
  (import (scheme base) (ccweave glue))
  (export kernel-info kernel-capabilities kernel-apply)
  (begin
    (define (kernel-info)
      '((name . codegen-wasm32) (version . "0.3.0")
        (description . "Selects a scalar WebAssembly instruction subset covering arithmetic, compares, memory, and control flow.")))
    (define (kernel-capabilities) '(codegen.wasm32))

    (define op-table
      '((imov       . wasm32.local.set)
        (iadd       . wasm32.add)
        (isub       . wasm32.sub)
        (imul       . wasm32.mul)
        (idiv       . wasm32.div_s)
        (irem       . wasm32.rem_s)
        (iand       . wasm32.and)
        (ior        . wasm32.or)
        (ixor       . wasm32.xor)
        (shl        . wasm32.shl)
        (lshr       . wasm32.shr_u)
        (ashr       . wasm32.shr_s)
        (ineg       . wasm32.neg)
        (inot       . wasm32.not)
        (icmp.eq    . wasm32.eq)
        (icmp.ne    . wasm32.ne)
        (icmp.lt    . wasm32.lt_s)
        (icmp.le    . wasm32.le_s)
        (icmp.gt    . wasm32.gt_s)
        (icmp.ge    . wasm32.ge_s)
        ;; FP arithmetic
        (fadd       . wasm32.f32.add)
        (fadd.d     . wasm32.f64.add)
        (fsub       . wasm32.f32.sub)
        (fsub.d     . wasm32.f64.sub)
        (fmul       . wasm32.f32.mul)
        (fmul.d     . wasm32.f64.mul)
        (fdiv       . wasm32.f32.div)
        (fdiv.d     . wasm32.f64.div)
        (fneg       . wasm32.f32.neg)
        (fneg.d     . wasm32.f64.neg)
        ;; FP compares
        (fcmp.eq    . wasm32.f32.eq)
        (fcmp.eq.d  . wasm32.f64.eq)
        (fcmp.lt    . wasm32.f32.lt)
        (fcmp.lt.d  . wasm32.f64.lt)
        (fcmp.gt    . wasm32.f32.gt)
        (fcmp.gt.d  . wasm32.f64.gt)
        (fcmp.le    . wasm32.f32.le)
        (fcmp.le.d  . wasm32.f64.le)
        (fcmp.ge    . wasm32.f32.ge)
        (fcmp.ge.d  . wasm32.f64.ge)
        ;; Width-specific loads
        (loadb      . wasm32.i32.load8_s)
        (loadub     . wasm32.i32.load8_u)
        (loadh      . wasm32.i32.load16_s)
        (loaduh     . wasm32.i32.load16_u)
        (load       . wasm32.load)
        (loadw      . wasm32.i32.load)
        (loadl      . wasm32.i64.load)
        ;; Width-specific stores
        (storeb     . wasm32.i32.store8)
        (storeh     . wasm32.i32.store16)
        (storew     . wasm32.i32.store)
        (store      . wasm32.store)
        (storel     . wasm32.i64.store)
        ;; Extension
        (extsb      . wasm32.i32.extend8_s)
        (extsh      . wasm32.i32.extend16_s)
        (extsw      . wasm32.i64.extend32_s)
        ;; FP conversions
        (exts       . wasm32.f64.promote_f32)
        (truncd     . wasm32.f32.demote_f64)
        (stosi      . wasm32.i32.trunc_f32_s)
        (dtosi      . wasm32.i32.trunc_f64_s)
        (swtof      . wasm32.f32.convert_i32_s)
        (sltof      . wasm32.f64.convert_i64_s)
        ;; Misc
        (udiv       . wasm32.div_u)
        (urem       . wasm32.rem_u)
        (copy       . wasm32.local.tee)
        (jmp        . wasm32.br)
        (br         . wasm32.br_if)
        (ret        . wasm32.return)
        (call       . wasm32.call)
        (call.dynamic . wasm32.call_indirect)
        (call.virtual . wasm32.call_indirect.virtual)
        (phi        . wasm32.phi)))

    (define (mapped op)
      (let ((entry (assq op op-table)))
        (and entry (cdr entry))))

    (define (ops ins)
      (let loop ((i 0) (xs '())) (if (>= i (instr-operand-count ins)) (reverse xs)
        (loop (+ i 1) (cons (instr-operand ins i) xs)))))

    (define (select! b)
      (let loop ((i 0)) (when (< i (block-instr-count b))
        (let* ((old (block-instr-ref b i)) (op (mapped (instr-opcode old))))
          (when op (let ((new (apply instr-build (cons op (ops old)))) (d (instr-dest old)))
            (when (string? d) (instr-set-dest! new d)) (instr-replace! old new)))
          (loop (+ i 1))))))

    (define (kernel-apply capability ir options)
      (unless (eq? capability 'codegen.wasm32) (error "codegen-wasm32: unsupported capability" capability))
      (unless (list? options) (error "codegen-wasm32: options must be an alist" options))
      (unless (glue-has? 'instr-set-dest!) (error "codegen-wasm32: scalar mutation accessors are unavailable"))
      (let f ((fi 0)) (when (< fi (ir-function-count))
        (let ((fn (ir-function-ref fi))) (let b ((bi 0)) (when (< bi (function-block-count fn))
          (select! (function-block-ref fn bi)) (b (+ bi 1))))) (f (+ fi 1))))
      ir)))
