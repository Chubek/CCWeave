PROJECT_NAME           = "TTyPack"
PROJECT_BRIEF          = "Header-only C++20 terminal libraries"
PROJECT_NUMBER         = "@PROJECT_VERSION@"

OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/generated"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/docs/frontpage.md" \
                         "@PROJECT_SOURCE_DIR@/docs/manual"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */generated/*
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"

USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/docs/frontpage.md"
LAYOUT_FILE            = "@CMAKE_CURRENT_SOURCE_DIR@/layout.xml"
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 210
HTML_COLORSTYLE_SAT    = 45
HTML_COLORSTYLE_GAMMA  = 90
GENERATE_TREEVIEW      = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
INLINE_SOURCES         = NO
SOURCE_BROWSER         = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/doxygen-warnings.log"
