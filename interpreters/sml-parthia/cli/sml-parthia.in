#!/bin/sh
# Installed sml-parthia launcher (generated by CMake; @ONLY substitution).
#
# Appends the directory the SML Basis Salvo was installed to, if it is
# installed, to the comma-separated SML_PARTHIA_PATH so `use "Basis.sml"`
# and bare native-library names resolve without further setup.  Entries
# the user provides keep precedence; resolution probes for existence, so
# a missing basis directory is inert.

basis='@CMAKE_INSTALL_FULL_DATADIR@/ccweave/sml-basis'
binary='@CMAKE_INSTALL_FULL_LIBEXECDIR@/ccweave/sml-parthia'

if [ -d "$basis" ]; then
  if [ -n "${SML_PARTHIA_PATH:-}" ]; then
    SML_PARTHIA_PATH="$SML_PARTHIA_PATH,$basis"
  else
    SML_PARTHIA_PATH="$basis"
  fi
  export SML_PARTHIA_PATH
fi

exec "$binary" "$@"
