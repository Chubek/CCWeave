CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -std=c11
CPPFLAGS ?= -I. -I../.. -I../../third_party/mpc -I../../third_party/lua \
	-I../../third_party/ucpp
LDFLAGS ?=
LDLIBS ?=

CCWMK_SRCS = \
	ccw-ccwmk.c \
	src/ast.c \
	src/fetch.c \
	src/exec.c \
	src/grammar.c \
	src/graph.c \
	src/lua.c \
	src/parse.c \
	src/plugin.c \
	src/scan-c.c \
	src/lua/lccwmk.c

all: ccwmk

ccwmk: $(CCWMK_SRCS)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(CCWMK_SRCS) -o $@ $(LDFLAGS) $(LDLIBS)

clean:
	rm -f ccwmk

