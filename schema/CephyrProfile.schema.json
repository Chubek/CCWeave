{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED by ccw-manifest — DO NOT EDIT. Regenerate with ccw-manifest; verify with ccw-manifest --check.",
  "title": "Cephyr Profile v1",
  "description": "Configuration schema shared by CEPHYR.yaml and CEPHYR.toml profiles.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Cephyr profile format version.",
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "default": "my-cephyr-profile"
    },
    "target": {
      "description": "Compilation target triple.",
      "type": "string",
      "minLength": 1,
      "default": "x86_64-linux-gnu"
    },
    "opt_level": {
      "description": "Default optimization level.",
      "enum": ["O0", "O1", "O2", "0", "1", "2"],
      "default": "O0"
    },
    "preprocessor": {
      "description": "Preprocessor command, or ucpp for the built-in preprocessor.",
      "type": "string",
      "default": "ucpp"
    },
    "manifest_dir": {
      "description": "Manifest directory, resolved relative to the profile.",
      "type": "string",
      "minLength": 1,
      "default": "manifests"
    },
    "sched_script": {
      "description": "Sched script path, resolved relative to the profile.",
      "type": "string",
      "minLength": 1
    },
    "assembler": {
      "description": "Assembler command override.",
      "type": "string",
      "minLength": 1
    },
    "linker": {
      "description": "Linker command override.",
      "type": "string",
      "minLength": 1
    },
    "include_paths": { "$ref": "#/$defs/stringArray" },
    "defines": { "$ref": "#/$defs/stringArray" },
    "preprocessor_options": { "$ref": "#/$defs/stringArray" },
    "preprocessor_args": { "$ref": "#/$defs/stringArray" },
    "assembler_options": { "$ref": "#/$defs/stringArray" },
    "assembler_args": { "$ref": "#/$defs/stringArray" },
    "linker_options": { "$ref": "#/$defs/stringArray" },
    "linker_args": { "$ref": "#/$defs/stringArray" },
    "library_paths": { "$ref": "#/$defs/stringArray" },
    "libraries": { "$ref": "#/$defs/stringArray" },
    "pic": { "type": "boolean", "default": false },
    "pie": { "type": "boolean", "default": false },
    "shared": { "type": "boolean", "default": false },
    "kernels": {
      "type": "array",
      "items": { "$ref": "#/$defs/kernel" },
      "default": []
    },
    "rewrites": {
      "type": "array",
      "items": { "$ref": "#/$defs/safeSchedScalar" },
      "default": []
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" },
      "default": []
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "safeSchedScalar": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\"\\\\\\r\\n]+$"
    },
    "capability": {
      "allOf": [
        { "$ref": "#/$defs/safeSchedScalar" },
        { "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" }
      ]
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/safeSchedScalar" },
        "capability": { "$ref": "#/$defs/capability" },
        "prefer": { "$ref": "#/$defs/safeSchedScalar" }
      },
      "oneOf": [
        {
          "required": ["name"],
          "not": { "required": ["capability"] }
        },
        {
          "required": ["capability"],
          "not": { "required": ["name"] }
        }
      ],
      "dependentRequired": {
        "prefer": ["capability"]
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "command"]
    }
  },
  "allOf": [
    {
      "not": {
        "allOf": [
          { "required": ["sched_script"] },
          {
            "anyOf": [
              {
                "required": ["kernels"],
                "properties": { "kernels": { "minItems": 1 } }
              },
              {
                "required": ["rewrites"],
                "properties": { "rewrites": { "minItems": 1 } }
              }
            ]
          }
        ]
      }
    }
  ]
}
