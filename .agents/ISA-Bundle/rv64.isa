arch rv64 {
    word_size = 64;
    addr_size = 64;
    endian    = little;
    align     = 8;
}


regclass GPR {
    T0(64),
    T1(64),
    T2(64),
    T3(64),
    T4(64),
    T5(64),
    A0(64),
    A1(64),
    A2(64),
    A3(64),
    A4(64),
    A5(64),
    A6(64),
    A7(64),
    S1(64),
    S2(64),
    S3(64),
    S4(64),
    S5(64),
    S6(64),
    S7(64),
    S8(64),
    S9(64),
    S10(64),
    S11(64),
    FP(64),
    SP(64),
    GP(64),
    TP(64),
    RA(64),
    T6(64),
}

regclass FPR {
    FT0(64),
    FT1(64),
    FT2(64),
    FT3(64),
    FT4(64),
    FT5(64),
    FT6(64),
    FT7(64),
    FT8(64),
    FT9(64),
    FT10(64),
    FA0(64),
    FA1(64),
    FA2(64),
    FA3(64),
    FA4(64),
    FA5(64),
    FA6(64),
    FA7(64),
    FS0(64),
    FS1(64),
    FS2(64),
    FS3(64),
    FS4(64),
    FS5(64),
    FS6(64),
    FS7(64),
    FS8(64),
    FS9(64),
    FS10(64),
    FS11(64),
    FT11(64),
}


