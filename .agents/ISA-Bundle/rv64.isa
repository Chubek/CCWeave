encoding F_TYPE {
    opcode : 7 = 0x53;
    rd : 5;
    funct3 : 3;
    rs1 : 5;
    rs2 : 5;
    fmt : 2;
    funct5 : 5;
}

encoding F_TYPE_STORE {
    opcode : 7 = 0x27;
    imm1 : 5;
    funct3 : 3;
    rs1 : 5;
    rs2 : 5;
    imm2 : 7;
}

encoding I_TYPE {
    opcode : 7 = 0x13;
    rd : 5;
    funct3 : 3;
    rs1 : 5;
    imm : 12;
}

encoding I_TYPE_64 {
    opcode : 7 = 0x1b;
    rd : 5;
    funct3 : 3;
    rs1 : 5;
    imm : 12;
}

encoding I_TYPE_JALR {
    opcode : 7 = 0x67;
    rd : 5;
    funct3 : 3 = 0x0;
    rs1 : 5;
    imm : 12;
}

encoding I_TYPE_LOAD {
    opcode : 7 = 0x03;
    rd : 5;
    funct3 : 3;
    rs1 : 5;
    imm : 12;
}

encoding R_TYPE {
    opcode : 7 = 0x33;
    rd : 5;
    funct3 : 3;
    rs1 : 5;
    rs2 : 5;
    funct7 : 7;
}

encoding S_TYPE {
    opcode : 7 = 0x23;
    imm1 : 5;
    funct3 : 3;
    rs1 : 5;
    rs2 : 5;
    imm2 : 7;
}


op add {
    class     = arithmetic;
    encoding  = R_TYPE;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "add%k %=, %0, %1";
}

op add {
    class     = arithmetic;
    encoding  = R_TYPE;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "fadd.%k %=, %0, %1";
}

