op swap {
    class     = misc;
    operands  = rs1: reg(GPR), rs1: reg(GPR), rs2: reg(GPR), rs2: reg(GPR);
    syntax    = "mv %?, %0\n\tmv %0, %1\n\tmv %1, %?";
}

