arch arm64 {
    word_size = 64;
    addr_size = 64;
    endian    = little;
    align     = 8;
}


regclass GPR {
    R0(64)=0,
    R1(64)=1,
    R2(64)=2,
    R3(64)=3,
    R4(64)=4,
    R5(64)=5,
    R6(64)=6,
    R7(64)=7,
    R8(64)=8,
    R9(64)=9,
    R10(64)=10,
    R11(64)=11,
    R12(64)=12,
    R13(64)=13,
    R14(64)=14,
    R15(64)=15,
    IP0(64)=16,
    IP1(64)=17,
    R18(64)=18,
    R19(64)=19,
    R20(64)=20,
    R21(64)=21,
    R22(64)=22,
    R23(64)=23,
    R24(64)=24,
    R25(64)=25,
    R26(64)=26,
    R27(64)=27,
    R28(64)=28,
    FP(64)=29,
    LR(64)=30,
    SP(64)=31,
}

regclass FPR {
    V0(128)=0,
    V1(128)=1,
    V2(128)=2,
    V3(128)=3,
    V4(128)=4,
    V5(128)=5,
    V6(128)=6,
    V7(128)=7,
    V8(128)=8,
    V9(128)=9,
    V10(128)=10,
    V11(128)=11,
    V12(128)=12,
    V13(128)=13,
    V14(128)=14,
    V15(128)=15,
    V16(128)=16,
    V17(128)=17,
    V18(128)=18,
    V19(128)=19,
    V20(128)=20,
    V21(128)=21,
    V22(128)=22,
    V23(128)=23,
    V24(128)=24,
    V25(128)=25,
    V26(128)=26,
    V27(128)=27,
    V28(128)=28,
    V29(128)=29,
    V30(128)=30,
}


