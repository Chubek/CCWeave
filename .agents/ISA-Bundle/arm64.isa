op call {
    class     = branch;
    encoding  = BR;
    operands  = rs1: reg(GPR);
    syntax    = "blr %L0";
}

op acmp {
    class     = compare;
    encoding  = DP_RR;
    operands  = rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "cmp %0, %1";
}

