flags NZCV { N, Z, C, V }


encoding BR {
    opcode : 11;
    opcode2 : 6;
    Rn : 5;
    opcode3 : 10;
}

encoding DP_RI {
    sf : 1;
    opcode : 7;
    imm : 12;
    Rn : 5;
    Rd : 5;
}

encoding DP_RR {
    sf : 1;
    opcode2 : 7;
    Rm : 5;
    opcode : 6;
    Rn : 5;
    Rd : 5;
}

encoding FP_CVT {
    opcode : 17;
    Rn : 5;
    Rd : 5;
}

encoding FP_SCALAR {
    opcode : 12;
    Rm : 5;
    opcode2 : 6;
    Rn : 5;
    Rd : 5;
}

encoding LS {
    size : 2;
    opcode : 6;
    imm : 9;
    Rn : 5;
    Rt : 5;
}


op add {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "add %=, %0, %1";
}

op add {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "fadd %=, %0, %1";
}

op sub {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "sub %=, %0, %1";
}

op sub {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "fsub %=, %0, %1";
}

op neg {
    class     = misc;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR);
    syntax    = "neg %=, %0";
}

op neg {
    class     = misc;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR);
    syntax    = "fneg %=, %0";
}

op and {
