op div {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "sdiv %=, %0, %1";
}

op div {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "fdiv %=, %0, %1";
}

op udiv {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rd: reg(GPR), rs1: reg(GPR), rs2: reg(GPR);
    syntax    = "udiv %=, %0, %1";
}

op rem {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rs1: reg(GPR), rs2: reg(GPR), rd: reg(GPR), rs2: reg(GPR), rs1: reg(GPR);
    syntax    = "sdiv %?, %0, %1\n\tmsub\t%=, %?, %1, %0";
}

op urem {
    class     = arithmetic;
    encoding  = DP_RR;
    operands  = rs1: reg(GPR), rs2: reg(GPR), rd: reg(GPR), rs2: reg(GPR), rs1: reg(GPR);
    syntax    = "udiv %?, %0, %1\n\tmsub\t%=, %?, %1, %0";
}

op copy {
    class     = misc;
    encoding  = DP_RI;
    operands  = rd: reg(GPR), rs1: reg(GPR);
    syntax    = "mov %=, %0";
}

op copy {
    class     = misc;
    encoding  = DP_RI;
    operands  = rd: reg(GPR), rs1: reg(GPR);
    syntax    = "fmov %=, %0";
}

op swap {
    class     = misc;
    encoding  = DP_RR;
    operands  = rs1: reg(GPR), rs1: reg(GPR), rs2: reg(GPR), rs2: reg(GPR);
    syntax    = "mov %?, %0\n\tmov\t%0, %1\n\tmov\t%1, %?";
}

op swap {
    class     = misc;
    encoding  = DP_RR;
    operands  = rs1: reg(GPR), rs1: reg(GPR), rs2: reg(GPR), rs2: reg(GPR);
    syntax    = "fmov %?, %0\n\tfmov\t%0, %1\n\tfmov\t%1, %?";
}

op storeb {
    class     = store;
    encoding  = LS;
    operands  = rs1: reg(GPR), rs2: mem(GPR);
    syntax    = "strb %W0, %M1";
}

op storeh {
    class     = store;
