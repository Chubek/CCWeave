# Salvo libc — build-tree stdlib manifest (configured by CMake).
#
# Same schema as the source-tree Libc.yaml, but include_dirs resolves to
# the source tree absolutely and library_paths to this build tree, so a
# Cephyr invoked from an arbitrary working directory can consume the
# library that was just built. Set:
#   CEPHYR_STDLIB_MANIFEST=@CMAKE_CURRENT_BINARY_DIR@/Libc.yaml
version: 1
name: salvo-libc
description: CCWeave Salvo C standard library for Cephyr (Linux, LP64)

include_dirs:
  - @CMAKE_CURRENT_SOURCE_DIR@/include

library_paths:
  - lib

libraries:
  - salvoc

start_files:
  - lib/crt0.o

targets:
  - triple: x86_64-linux-gnu
  - triple: x86_64-unknown-linux-gnu
  - triple: x86_64-pc-linux-gnu
  - triple: aarch64-linux-gnu
  - triple: aarch64-unknown-linux-gnu
  - triple: riscv64-linux-gnu
  - triple: riscv64-unknown-linux-gnu
